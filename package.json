{
  "name": "spybox",
  "version": "0.1.0",
  "private": true,
  "description": "A Boxworld/Sokoban recreation with original spy-family-inspired characters — full retro pixel-art edition.",
  "type": "module",
  "scripts": {
    "tailwind:build": "bun --bun x tailwindcss -i ./src/tailwind.css -o ./src/tailwind.generated.css",
    "dev": "bun run tailwind:build && bun index.html",
    "dev:hot": "bun run tailwind:build && bun --hot index.html",
    "build": "bun run tailwind:build && bun build ./index.html --outdir dist --minify",
    "start": "bun run dist/index.html",
    "typecheck": "bun --bun x tsc --noEmit",
    "test": "bun test"
  },
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.15",
    "@tailwindcss/cli": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "19",
    "react-dom": "19",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "19",
    "@types/react-dom": "19",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
